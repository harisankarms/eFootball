# Copy this file to ".env.local" and fill in the two values from your Supabase project
# (Supabase dashboard -> Project Settings -> API Keys / Data API).
# Leave them empty to run the site in demo mode with sample data.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The "Publishable" key (starts with sb_publishable_) or the legacy "anon" key.
# Never put the secret / service_role key here.
VITE_SUPABASE_KEY=
